# Copy to `.env` and set the serial device of the receiver board.
#
# Find it with:   ls -l /dev/serial/by-id/
# Prefer the /dev/serial/by-id/... path — it survives reboots and re-plugs,
# unlike /dev/ttyACM0 or /dev/ttyUSB0 which can shuffle.
#
# Native-USB boards (WiFi LoRa 32 V3/V4) enumerate as ttyACM*,
# CP2102 boards (Wireless Stick V3) as ttyUSB*.
SERIAL_PORT=/dev/serial/by-id/CHANGE-ME

# Where the PWA repo is checked out. Only needed if it isn't next to this
# folder as ../central_node_pwa.
# PWA_DIR=../central_node_pwa
